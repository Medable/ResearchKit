/* Short walk back and forth. */
"WALK_INTRO_2_TEXT_BACK_AND_FORTH_INSTRUCTION" = "நீங்கள் ஒரு நேர்க்கோட்டில் பாதுகாப்பாக முன்னும், பின்னுமாக நடக்கக்கூடிய ஒரு இடத்தைக் கண்டறியவும். நீங்கள் ஒரு கூம்பைச் சுற்றி நடப்பது போல், உங்கள் பாதையின் முனைகளில் திரும்புவதன் மூலம் தொடர்ந்து நடக்க முயற்சி செய்யுங்கள்.\n\nஅடுத்து நீங்கள் ஒரு முழு வட்டத்தில் திரும்பும்படியும், பின்னர் உங்கள் கரங்களை உங்கள் பக்கவாட்டில் வைத்துக் கொண்டும், உங்கள் கால்களைத் தோள்பட்டை அகலத்திற்கு விரித்தும் அசையாமல் நிற்கவும் அறிவுறுத்தப்படுவீர்கள்.";

